<?xml version="1.0" encoding="utf-8"?>
<!--
    app/src/main/res/layout/activity_home.xml
    Dashboard screen — matches screen 3 from your mockups.
    Static placeholder data for now, wired to real DB in next feature.
-->
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F0E8"
        android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

        <!-- ── TOP BAR ── -->
        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="16dp">

            <ImageView
                    android:id="@+id/btn_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="@drawable/circle_outline"
                    android:padding="8dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:contentDescription="Menu" />

            <!-- Two-colour title — styled in XML using two TextViews -->
            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_centerInParent="true">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SpotMy"
                        android:textColor="#111111"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dime"
                        android:textColor="#2E7D32"
                        android:textSize="20sp"
                        android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                    android:id="@+id/btn_notifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_popup_reminder"
                    android:background="@drawable/circle_outline"
                    android:padding="8dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="Notifications" />
        </RelativeLayout>

        <!-- ── GREETING ── -->
        <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi there 👋"
                android:textColor="#111111"
                android:textSize="16sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp" />

        <!-- ── THIS MONTH CARD ── -->
        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

            <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                <LinearLayout
                        android:id="@+id/ll_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This Month"
                            android:textColor="#888888"
                            android:textSize="13sp" />

                    <TextView
                            android:id="@+id/tv_total_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textColor="#111111"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Net Cash Flow"
                            android:textColor="#888888"
                            android:textSize="13sp" />

                    <!-- Trend indicator -->
                    <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp">

                        <TextView
                                android:id="@+id/tv_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#2E7D32"
                                android:textSize="13sp"
                                android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Placeholder donut chart icon -->
                <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@android:drawable/ic_menu_report_image"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Spending chart" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── TOP CATEGORIES ── -->
        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="24dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top Categories"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
        </RelativeLayout>

        <LinearLayout
                android:id="@+id/container_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="12dp" />

        <!-- ── RECENT TRANSACTIONS ── -->
        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="8dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Transactions"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
        </RelativeLayout>

        <TextView
                android:id="@+id/tv_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading transactions..."
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:visibility="gone" />

        <LinearLayout
                android:id="@+id/container_transactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>