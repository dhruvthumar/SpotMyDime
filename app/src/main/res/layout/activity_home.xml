<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF7F2">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingTop="38dp"
            android:paddingBottom="80dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- ════════════════════════════════════════════════ -->
            <!-- TAB 1 – HOME CONTENT (Redesigned)               -->
            <!-- ════════════════════════════════════════════════════ -->
            <LinearLayout
                    android:id="@+id/container_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- ═══ TOP APP BAR ═══ -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="#FAF7F2"
                        android:paddingHorizontal="14dp">

                    <TextView
                            android:id="@+id/tv_wordmark_spotmy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SpotMy"
                            android:textColor="#1A1A1A"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/tv_wordmark_dime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dime"
                            android:textColor="#1E7A4C"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginStart="2dp" />
                </LinearLayout>

                <!-- ═══ NET CASH FLOW CARD ═══ -->
                <androidx.cardview.widget.CardView
                        android:id="@+id/card_net_cashflow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="14dp"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardUseCompatPadding="true">

                    <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="18dp">

                        <LinearLayout
                                android:id="@+id/ll_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true">

                            <TextView
                                    android:id="@+id/tv_month_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="This Month"
                                    android:textColor="#1A1A1A"
                                    android:textSize="14sp" />

                            <TextView
                                    android:id="@+id/tv_total_amount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$0.00"
                                    android:textColor="#1A1A1A"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="4dp" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Net Cash Flow"
                                    android:textColor="#6B6B6B"
                                    android:textSize="14sp" />

                            <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="8dp">

                                <ImageView
                                        android:id="@+id/iv_trend_arrow"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_arrow_up"
                                        android:contentDescription="Trend"
                                        android:visibility="gone" />

                                <TextView
                                        android:id="@+id/tv_trend"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=""
                                        android:textColor="#1E7A4C"
                                        android:textSize="13sp"
                                        android:paddingStart="4dp"
                                        android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                                android:id="@+id/ll_income_expense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:orientation="vertical"
                                android:gravity="end">

                            <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">
                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Income"
                                        android:textColor="#1E7A4C"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                <ImageView
                                        android:id="@+id/iv_income_arrow"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/ic_arrow_up"
                                        android:contentDescription="Income"
                                        android:layout_marginStart="4dp" />
                            </LinearLayout>

                            <TextView
                                    android:id="@+id/tv_income_amount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$0.00"
                                    android:textColor="#1E7A4C"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="2dp" />

                            <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="10dp">
                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Expense"
                                        android:textColor="#E53935"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                <ImageView
                                        android:id="@+id/iv_expense_arrow"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/ic_arrow_down"
                                        android:contentDescription="Expense"
                                        android:layout_marginStart="4dp" />
                            </LinearLayout>

                            <TextView
                                    android:id="@+id/tv_expense_amount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$0.00"
                                    android:textColor="#E53935"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="2dp" />
                        </LinearLayout>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- ═══ TOP CATEGORIES SECTION ═══ -->
                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="14dp">

                    <TextView
                            android:id="@+id/tv_section_categories_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Top Categories"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true" />

                    <TextView
                            android:id="@+id/tv_section_categories_viewall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View all"
                            android:textColor="#6B6B6B"
                            android:textSize="13sp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />
                </RelativeLayout>

                <LinearLayout
                        android:id="@+id/container_categories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="6dp" />

                <!-- ═══ RECENT TRANSACTIONS SECTION ═══ -->
                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="14dp">

                    <TextView
                            android:id="@+id/tv_section_transactions_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recent Transactions"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true" />

                    <TextView
                            android:id="@+id/tv_section_transactions_viewall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View all"
                            android:textColor="#6B6B6B"
                            android:textSize="13sp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />
                </RelativeLayout>

                <LinearLayout
                        android:id="@+id/container_transactions_home"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- ════════════════════════════════════════════════════ -->
            <!-- TAB 2 – TRANSACTIONS                                -->
            <!-- ════════════════════════════════════════════════════ -->
            <LinearLayout
                    android:id="@+id/container_document"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingHorizontal="20dp"
                        android:layout_marginTop="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transactions"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_centerVertical="true" />

                    <TextView
                            android:id="@+id/tv_clear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear"
                            android:textColor="#F9AC54"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                </RelativeLayout>

                <EditText
                        android:id="@+id/et_search"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/input_outline"
                        android:hint="Search transactions..."
                        android:textColorHint="#999999"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:paddingHorizontal="16dp"
                        android:gravity="center_vertical"
                        android:inputType="text"
                        android:imeOptions="actionSearch" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:layout_marginTop="4dp">

                    <TextView
                            android:id="@+id/btn_filter_category"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Category"
                            android:textColor="#6B6B6B"
                            android:textSize="13sp"
                            android:background="@drawable/input_outline"
                            android:layout_marginEnd="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                    <TextView
                            android:id="@+id/btn_filter_date"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Date"
                            android:textColor="#6B6B6B"
                            android:textSize="13sp"
                            android:background="@drawable/input_outline"
                            android:layout_marginEnd="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                    <TextView
                            android:id="@+id/btn_filter_all"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Clear"
                            android:textColor="#F9AC54"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/input_outline"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                </LinearLayout>

                <!-- Type Filter + Sort Row -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:layout_marginTop="6dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sort:"
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:layout_marginEnd="4dp" />

                    <TextView
                            android:id="@+id/tv_sort_label"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="Newest"
                            android:textColor="#111111"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="10dp"
                            android:background="@drawable/input_outline"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                    <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                    <TextView
                            android:id="@+id/chip_filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="All"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/nav_bg_active"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                    <TextView
                            android:id="@+id/chip_filter_income"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="Income"
                            android:textColor="#2B9348"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_chip_outline"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                    <TextView
                            android:id="@+id/chip_filter_expense"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="Expense"
                            android:textColor="#E53935"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_chip_outline"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                </LinearLayout>

                <TextView
                        android:id="@+id/tv_filtered_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone" />

                <TextView
                        android:id="@+id/tv_loading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading transactions..."
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:layout_marginTop="32dp"
                        android:layout_marginStart="20dp"
                        android:visibility="gone" />

                <TextView
                        android:id="@+id/tv_date_range_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                <LinearLayout
                        android:id="@+id/container_transactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- ════════════════════════════════════════════════════ -->
            <!-- TAB 3 – ADD EXPENSE / INCOME                        -->
            <!-- ════════════════════════════════════════════════════ -->
            <LinearLayout
                    android:id="@+id/container_add"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:paddingHorizontal="20dp"
                        android:layout_marginTop="20dp">

                    <ImageView
                            android:id="@+id/btn_back_add"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_media_previous"
                            android:layout_centerVertical="true"
                            android:padding="12dp"
                            android:contentDescription="Back" />

                    <TextView
                            android:id="@+id/tv_add_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add Expense"
                            android:textColor="#111111"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_centerInParent="true" />
                </RelativeLayout>

                <LinearLayout
                        android:id="@+id/toggle_container"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="32dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/toggle_bg"
                        android:orientation="horizontal"
                        android:gravity="center">

                    <TextView
                            android:id="@+id/toggle_expense"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Expense"
                            android:textColor="#E53935"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:background="@drawable/toggle_active"
                            android:clickable="true"
                            android:focusable="true" />

                    <TextView
                            android:id="@+id/toggle_income"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Income"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:layout_marginTop="32dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    <TextView
                            android:id="@+id/et_date"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/input_outline"
                            android:hint="Pick"
                            android:textColorHint="#F9AC54"
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:paddingHorizontal="20dp"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="20dp"
                            android:clickable="true"
                            android:focusable="true" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    <TextView
                            android:id="@+id/et_category"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/input_outline"
                            android:hint="Select"
                            android:textColorHint="#F9AC54"
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:paddingHorizontal="20dp"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="20dp"
                            android:clickable="true"
                            android:focusable="true" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Amount"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    <EditText
                            android:id="@+id/et_amount"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/input_outline"
                            android:hint="$"
                            android:textColorHint="#F9AC54"
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:paddingHorizontal="20dp"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="20dp"
                            android:inputType="numberDecimal" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Payment Method"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    <TextView
                            android:id="@+id/et_payment"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/input_outline"
                            android:hint="Select"
                            android:textColorHint="#F9AC54"
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:paddingHorizontal="20dp"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="20dp"
                            android:clickable="true"
                            android:focusable="true" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notes"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    <EditText
                            android:id="@+id/et_notes"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/input_outline"
                            android:hint="Write"
                            android:textColorHint="#F9AC54"
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:paddingHorizontal="20dp"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="32dp" />

                </LinearLayout>

                <TextView
                        android:id="@+id/btn_save"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:paddingHorizontal="48dp"
                        android:gravity="center"
                        android:text="save"
                        android:textColor="#E53935"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_save_outline"
                        android:clickable="true"
                        android:focusable="true" />

            </LinearLayout>

            <!-- ════════════════════════════════════════════════════ -->
            <!-- TAB 4 – INSIGHTS                                    -->
            <!-- ════════════════════════════════════════════════════ -->
            <LinearLayout
                    android:id="@+id/container_insights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingBottom="24dp">

                <TextView
                        android:id="@+id/tv_insights_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Insights"
                        android:textColor="#000000"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="16dp" />

                <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:paddingHorizontal="20dp"
                        android:layout_marginBottom="20dp">
                    <LinearLayout
                            android:id="@+id/insights_sub_nav"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" />
                </HorizontalScrollView>

                <include layout="@layout/tab_insight_overview" />

                <include layout="@layout/tab_insight_spending" />

                <include layout="@layout/tab_insight_income" />

                <include layout="@layout/tab_insight_trends" />

            </LinearLayout>

            <!-- ════════════════════════════════════════════════════ -->
            <!-- TAB 5 – SETTINGS                                    -->
            <!-- ════════════════════════════════════════════════════ -->
            <LinearLayout
                    android:id="@+id/container_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingBottom="24dp">

                <include layout="@layout/activity_settings" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- FLOATING NAVIGATION BAR (Redesigned)                -->
    <!-- ════════════════════════════════════════════════════ -->
    <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/nav_bar_bg"
            android:paddingHorizontal="4dp"
            android:clipToPadding="false"
            android:outlineProvider="none">

        <!-- HOME TAB -->
        <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">
            <LinearLayout
                    android:id="@+id/nav_home"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/nav_tab_circle_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                <ImageView
                        android:id="@+id/ic_nav_home"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_nav_home"
                        android:contentDescription="Home"/>
            </LinearLayout>
        </FrameLayout>

        <!-- TRANSACTIONS TAB -->
        <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">
            <LinearLayout
                    android:id="@+id/nav_document"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/nav_tab_circle_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                <ImageView
                        android:id="@+id/ic_nav_document"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_nav_document"
                        android:contentDescription="Transactions"/>
            </LinearLayout>
        </FrameLayout>

        <!-- ADD TAB -->
        <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">
            <LinearLayout
                    android:id="@+id/nav_add"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/nav_tab_circle_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                <ImageView
                        android:id="@+id/ic_nav_add"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_nav_add"
                        android:contentDescription="Add Transaction"/>
            </LinearLayout>
        </FrameLayout>

        <!-- INSIGHTS TAB -->
        <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">
            <LinearLayout
                    android:id="@+id/nav_insights"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/nav_tab_circle_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                <ImageView
                        android:id="@+id/ic_nav_insights"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_nav_gallery"
                        android:contentDescription="Insights"/>
            </LinearLayout>
        </FrameLayout>

        <!-- SETTINGS TAB -->
        <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">
            <LinearLayout
                    android:id="@+id/nav_settings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/nav_tab_circle_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                <ImageView
                        android:id="@+id/ic_nav_settings"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_nav_settings"
                        android:contentDescription="Settings"/>
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>