<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F0E8"
        android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="28dp"
            android:paddingTop="72dp"
            android:paddingBottom="48dp">

        <!--
            Gmail logo — replace with actual Gmail PNG:
            put gmail_logo.png in res/drawable/ and change src to @drawable/gmail_logo
        -->
        <ImageView
                android:id="@+id/iv_gmail_logo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_dialog_email"
                android:scaleType="fitCenter"
                android:contentDescription="Gmail logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <!-- Permission explanation text -->
        <TextView
                android:id="@+id/tv_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="SpotMyDime needs access to your Gmail to read transaction emails."
                android:textColor="#444444"
                android:textSize="16sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/iv_gmail_logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <!-- Trust point 1 -->
        <LinearLayout
                android:id="@+id/trust_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/tv_desc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/circle_green" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The App only reads specific emails"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No sending, deleting or managing your emails"
                        android:textColor="#666666"
                        android:textSize="13sp"
                        android:layout_marginTop="3dp"
                        android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trust point 2 -->
        <LinearLayout
                android:id="@+id/trust_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/trust_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/circle_green" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your data stays on your device"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Everything is stored locally on your phone"
                        android:textColor="#666666"
                        android:textSize="13sp"
                        android:layout_marginTop="3dp"
                        android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trust point 3 -->
        <LinearLayout
                android:id="@+id/trust_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/trust_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/circle_green" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You have full control"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You can disconnect anytime"
                        android:textColor="#666666"
                        android:textSize="13sp"
                        android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connect Gmail button -->
        <Button
                android:id="@+id/btn_connect_gmail"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="Connect Gmail"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"
                android:stateListAnimator="@null"
                android:layout_marginTop="44dp"
                app:layout_constraintTop_toBottomOf="@id/trust_3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:cornerRadius="14dp" />

        <!-- Privacy policy link -->
        <TextView
                android:id="@+id/tv_privacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read our Privacy &amp; Policy"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/btn_connect_gmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>