<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cream_bg"
        android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="28dp"
            android:paddingTop="64dp"
            android:paddingBottom="48dp">

        <ImageView
                android:id="@+id/iv_gmail_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@android:drawable/ic_dialog_email"
                android:scaleType="fitCenter"
                android:alpha="0.7"
                android:contentDescription="Gmail logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Connect your Gmail"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:gravity="center"
                android:fontFamily="@font/google_sans_flex_24pt"
                android:fontWeight="600"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/iv_gmail_logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <TextView
                android:id="@+id/tv_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/connect_desc"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
                android:id="@+id/trust_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginTop="36dp"
                app:layout_constraintTop_toBottomOf="@id/tv_desc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:background="@drawable/circle_green"
                    android:fontFamily="@font/google_sans_flex_24pt"
                    android:fontWeight="700" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_trust_1_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontWeight="600" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_trust_1_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:id="@+id/trust_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/trust_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:background="@drawable/circle_green"
                    android:fontFamily="@font/google_sans_flex_24pt"
                    android:fontWeight="700" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_trust_2_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontWeight="600" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_trust_2_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:id="@+id/trust_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/trust_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:background="@drawable/circle_green"
                    android:fontFamily="@font/google_sans_flex_24pt"
                    android:fontWeight="700" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_trust_3_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontWeight="600" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_trust_3_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </LinearLayout>

        <Button
                android:id="@+id/btn_connect_gmail"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="@string/connect_cta"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:backgroundTint="@color/green_primary"
                android:stateListAnimator="@null"
                android:layout_marginTop="36dp"
                app:layout_constraintTop_toBottomOf="@id/trust_3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:cornerRadius="16dp" />

        <TextView
                android:id="@+id/tv_privacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_privacy"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/btn_connect_gmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
